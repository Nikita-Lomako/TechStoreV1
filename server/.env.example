# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=true
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (local PostgreSQL from docker-compose)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://techstore:techstore@localhost:5432/techstore?schema=public
DIRECT_URL=postgresql://techstore:techstore@localhost:5432/techstore?schema=public

# Supabase example (use the pooler for the app and the direct connection for migrations):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=90

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=15
# Exposes resetToken in the API response when SMTP is not configured. Never enable in production.
EXPOSE_RESET_TOKEN=true

# ---------------------------------------------------------------------------
# URLs and CORS
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://nikita-lomako.github.io
PUBLIC_API_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
TAX_RATE=0.08
RATE_LIMIT_MAX=200
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Supabase Storage (optional locally, required for admin image uploads)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
UPLOAD_MAX_BYTES=5242880

# ---------------------------------------------------------------------------
# SMTP (optional). When empty, reset links are written to the server log.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TechStore <no-reply@techstore.local>
