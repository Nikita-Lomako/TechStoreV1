# ---------------------------------------------------------------------------
# Docker Compose / local stack
# Copy this file to .env before running: cp .env.example .env
# ---------------------------------------------------------------------------
POSTGRES_USER=techstore
POSTGRES_PASSWORD=techstore
POSTGRES_DB=techstore

# NODE_ENV is intentionally not set here: Vite uses development for `npm run dev`
# and production for `npm run build`; docker-compose sets NODE_ENV=production
# for the API container.

HOST=0.0.0.0
PORT=3000
TRUST_PROXY=true
LOG_LEVEL=info

# The app service overrides these two so that it can reach the postgres container.
DATABASE_URL=postgresql://techstore:techstore@localhost:5432/techstore?schema=public
DIRECT_URL=postgresql://techstore:techstore@localhost:5432/techstore?schema=public

REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=90

JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=15
EXPOSE_RESET_TOKEN=false

CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://nikita-lomako.github.io
PUBLIC_API_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

TAX_RATE=0.08
RATE_LIMIT_MAX=200
SWAGGER_ENABLED=true

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
UPLOAD_MAX_BYTES=5242880

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TechStore <no-reply@techstore.local>

# Seed demo catalog/accounts on every container start. Set to false after the first run.
RUN_SEED=true

# Frontend (Vite reads VITE_* variables from this file during local development)
VITE_API_URL=http://localhost:3000
